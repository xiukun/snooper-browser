{
  "manifest_version": 3,
  "name": "RTTS - 实时多模态智能翻译",
  "version": "0.3.0",
  "description": "实时网页音视频双语字幕与 AI 伴学 - 每标签页独立会话",
  "action": {
    "default_title": "RTTS - 点击开启当前页面的实时翻译浮层"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabCapture",
    "offscreen",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["audio-worklet.js", "fullscreen-bridge.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
