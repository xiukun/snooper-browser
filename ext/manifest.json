{
  "manifest_version": 3,
  "name": "snooper-browser",
  "short_name": "snooper",
  "version": "0.8.4",
  "minimum_chrome_version": "116",
  "description": "\u5b9e\u65f6\u7ffb\u8bd1 \u00b7 \u667a\u80fd\u7b14\u8bb0 \u00b7 AI \u56fe\u50cf\u521b\u4f5c \u2014 \u6d4f\u89c8\u5668\u5185\u4e00\u7ad9\u5f0f\u5de5\u4f5c\u53f0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "snooper-browser \u2014 \u70b9\u51fb\u6253\u5f00\u7b14\u8bb0\u4e0e\u96c6\u6210\u9762\u677f",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabCapture",
    "offscreen",
    "sidePanel",
    "unlimitedStorage",
    "management"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "audio-worklet.js",
        "fullscreen-bridge.js",
        "image-viewer.html",
        "image-viewer.js",
        "assets/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
