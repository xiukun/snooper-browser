{
  "name": "snooper-browser",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Open-source multimodal workspace for real-time translation, conversations and visual understanding.",
  "license": "Apache-2.0",
  "scripts": {
    "build:ext": "node build-ext.mjs",
    "package:ext": "node scripts/package-extension.mjs",
    "dev:app": "cd app && pnpm dev",
    "build:app": "cd app && pnpm build",
    "type-check": "cd app && pnpm exec vue-tsc -b --force",
    "test:guards": "node scripts/test-audio-guards.mjs",
    "test:spectrum-gate": "node scripts/test-audio-spectrum-gate.mjs",
    "test:capture-generation": "node scripts/test-capture-generation.mjs",
    "test:keyed-task": "node scripts/test-keyed-task.mjs",
    "test:export-assets": "node scripts/test-export-assets.mjs",
    "test:chat-state": "node scripts/test-chat-state.mjs",
    "test:transcript": "node scripts/test-transcript-store.mjs",
    "test:video-clock": "node scripts/test-video-clock.mjs",
    "test:subtitle-order": "node scripts/test-subtitle-order.mjs",
    "test:video-presence": "node scripts/test-video-presence.mjs",
    "test:content-refs": "node scripts/test-content-refs.mjs",
    "test:content-install": "node scripts/test-content-install.mjs",
    "test:deep-link": "node scripts/test-deep-link.mjs",
    "test:markdown": "node scripts/test-markdown.mjs",
    "test:session-state": "node scripts/test-session-state.mjs",
    "test:image-material": "node scripts/test-image-material.mjs",
    "test:ext-globals": "node scripts/check-ext-no-vite-globals.mjs"
  },
  "dependencies": {
    "docx": "^9.15.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
