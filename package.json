    "test:video-clock": "node scripts/test-video-clock.mjs",
    "test:subtitle-order": "node scripts/test-subtitle-order.mjs",
    "test:video-presence": "node scripts/test-video-presence.mjs",
    "test:content-refs": "node scripts/test-content-refs.mjs",
    "test:screen-caption": "node scripts/test-screen-caption.mjs",
