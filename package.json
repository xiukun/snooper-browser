{
  "name": "snooper-browser",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Open-source multimodal workspace for real-time translation, conversations and visual understanding.",
  "license": "Apache-2.0",
  "scripts": {
    "build:ext": "node build-ext.mjs",
    "package:ext": "node scripts/package-extension.mjs",
    "dev:app": "cd app && pnpm dev",
    "build:app": "cd app && pnpm build",
    "type-check": "cd app && pnpm exec vue-tsc -b --force",
    "test:guards": "node scripts/test-audio-guards.mjs",
    "test:capture-generation": "node scripts/test-capture-generation.mjs",
    "test:keyed-task": "node scripts/test-keyed-task.mjs",
    "test:chat-state": "node scripts/test-chat-state.mjs",
    "test:image-material": "node scripts/test-image-material.mjs"
  },
  "dependencies": {
    "docx": "^9.15.2"
  }
}
